# ── Sitio ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://nexus-ia.com.es"

# ── Supabase (proyecto liberty-trading-pro) ───────────────────────────────────
# Solo se usa como base de datos (tablas nexus_*), no para autenticación.
NEXT_PUBLIC_SUPABASE_URL=""
# Solo servidor. Salta RLS: nunca exponerla al navegador.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Panel privado ─────────────────────────────────────────────────────────────
# Login propio de Nexus: un solo operador, contraseña compartida + cookie
# firmada. No usa Supabase Auth: ese proyecto de auth es de los clientes de
# Liberty y el admin de Nexus no pertenece ahí.
PANEL_PASSWORD=""
# Clave para firmar la cookie de sesión. Mínimo 32 caracteres.
# Cambiarla cierra todas las sesiones abiertas.
PANEL_SESSION_SECRET=""

# ── Proveedores de IA ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="deepseek/deepseek-chat"
# Fallback automático cuando OpenRouter responde 402 (sin crédito).
MINIMAX_API_KEY=""
MINIMAX_MODEL="MiniMax-Text-01"

# ── Evolution API (WhatsApp) ──────────────────────────────────────────────────
EVOLUTION_API_URL="https://evo.nexus-ia.com.es"
EVOLUTION_INSTANCE="dr-cmadminlri"
EVOLUTION_API_KEY=""

# ── n8n ───────────────────────────────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL="https://n8n.nexus-ia.com.es/webhook"
# Workflows que el agente puede disparar, separados por coma.
# Vacío = la herramienta disparar_workflow no se le ofrece al modelo.
N8N_ALLOWED_WORKFLOWS=""
N8N_WEBHOOK_SECRET=""
